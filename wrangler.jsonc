{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name is deliberately brand-neutral (§0 brand isolation).
  // Live fixture-beta deployment for backtoacademy.com. Resource IDs below
  // belong to the production Cloudflare account; fixture mode describes the
  // data adapters, not whether the infrastructure is remote.
  "name": "k8-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "routes": [
    {
      "pattern": "backtoacademy.com",
      "custom_domain": true
    },
    {
      "pattern": "www.backtoacademy.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "FIXTURE_MODE": "true"
  },
  // D1 binding (Phase 1, data-architect). The live database stores anonymous
  // fixture-beta sessions and plans. Apply migrations with `--remote` before
  // deploy; paired down migrations live in migrations/down/ and are exercised
  // by tests/schema.test.ts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "k8-planner-fixture",
      "database_id": "d467a443-5b38-4995-85ff-d26899ff3fb5",
      "migrations_dir": "migrations"
    }
  ],
  // KV (Phase 2, ingestion-engineer): one namespace for the §2-sanctioned
  // source-health snapshots ('health:<sourceId>'), stale-while-revalidate
  // cache envelopes ('cache:<sourceId>'), and runtime flag overrides
  // ('flags:overrides') — key prefixes in src/ingestion/source-health.ts.
  // The namespace is live; its contents remain fixture-source cache metadata.
  "kv_namespaces": [
    {
      "binding": "SOURCE_KV",
      "id": "d3d1313129604e5d83be2de8a8fffe74"
    }
  ],
  // R2 (Phase 3, parser-engineer): §2 sanctions R2 ONLY for transient upload
  // buffers with a hard TTL — this bucket is exactly and exclusively that.
  // Uploaded list photos/PDFs are buffered here, OCR'd, and deleted in a
  // `finally` block the moment processing ends (src/parsing/upload-buffer.ts,
  // UPLOAD_BUFFER_TTL_SECONDS = 900). R2 lifecycle rules have day
  // granularity, so the TTL is additionally enforced in code: expired
  // objects are unreadable and deleted on access/sweep. Nothing else may use
  // this bucket, and nothing from an upload may reach KV or D1 as raw
  // bytes/text (§1.7). A one-day R2 lifecycle rule is defense in depth; the
  // application-level delete/15-minute TTL remains the primary guarantee.
  "r2_buckets": [
    {
      "binding": "UPLOAD_BUFFER",
      "bucket_name": "k8-planner-upload-buffer-fixture"
    }
  ],
  // Static Assets (Phase 7, frontend-engineer): §2 stack is Workers +
  // Static Assets. public/ carries ONLY static UI files — self-hosted OFL
  // font binaries (+ licenses), the progressive-enhancement script, and the
  // offline service worker. HTML is rendered by the Worker; requests that
  // match no asset fall through to it (default run order).
  "assets": {
    "directory": "public"
  },
  // Queues (Phase 5, backend-api): §2 sanctions Queues for background jobs —
  // this queue carries EXACTLY the ingestion-refresh contract from Phase 2
  // (src/ingestion/jobs.ts RefreshJobMessage; INGESTION_QUEUE_NAME
  // = 'ingestion-refresh'). The consumer re-seeds the SWR caches through the
  // same adapter + circuit-breaker pipelines the API reads from; in fixture
  // posture this re-labels fixture envelopes (no network — live sources stay
  // flag-OFF and their adapters are throwing stubs). No Durable Objects are
  // provisioned: §2 reserves DO for live family-collaboration sessions,
  // which do not exist in this beta (rate limiting is KV token buckets).
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "ingestion-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "ingestion-refresh",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "retry_delay": 30
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
